<% content_for :title, t(".title") %>

<div class="auth-split">
  <%= render "devise/shared/intro_panel" %>

  <div class="auth-form-panel">
    <div class="auth-form">
      <div class="auth-form__title"><%= t(".title") %></div>
      <div class="auth-form__subtitle"><%= t(".subtitle") %></div>

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
        <% if resource.errors.any? %>
          <div class="form-errors" role="alert">
            <ul>
              <% resource.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="field">
          <%= f.label :first_name %>
          <%= f.text_field :first_name, autofocus: true %>
        </div>

        <div class="field">
          <%= f.label :last_name %>
          <%= f.text_field :last_name %>
        </div>

        <div class="field">
          <%= f.label :email %>
          <%= f.email_field :email, autocomplete: "email" %>
        </div>

        <div class="field">
          <%= f.label :password %>
          <% if @minimum_password_length %>
            <span class="field-hint"><%= t(".min_chars", count: @minimum_password_length) %></span>
          <% end %>
          <%= f.password_field :password, autocomplete: "new-password" %>
        </div>

        <div class="field">
          <%= f.label :password_confirmation %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
        </div>

        <%= f.submit t(".submit"), class: "btn btn-primary" %>
      <% end %>

      <div class="auth-form__switch">
        <span><%= t(".already_have_one") %></span>
        <%= link_to t(".sign_in"), new_user_session_path %>
      </div>
    </div>

    <%= render "devise/shared/mode_switch", active: :signup %>
  </div>
</div>
