<% content_for :title, t(".title") %>

<div class="page-header">
  <div>
    <h1 class="page-title"><%= t(".title") %></h1>
    <div class="page-subtitle"><%= t(".as_of", date: l(Date.current, format: :full)) %></div>
  </div>
  <% if @all_portfolios.any? %>
    <div style="display: flex; gap: 8px;">
      <%= link_to t(".all_portfolios"), root_path, class: class_names("pill", active: params[:portfolio_id].blank?) %>
      <% @all_portfolios.each do |portfolio| %>
        <%= link_to portfolio.name, root_path(portfolio_id: portfolio.id),
              class: class_names("pill", active: params[:portfolio_id] == portfolio.id.to_s) %>
      <% end %>
    </div>
  <% end %>
</div>

<% if @portfolios.empty? %>
  <div class="card">
    <p><%= t(".empty") %></p>
    <%= link_to t(".create_first"), new_portfolio_path, class: "btn btn-primary" %>
  </div>
<% else %>
  <% if @unpriced_count.positive? %>
    <div class="banner banner-warning">
      <%= t(".unpriced_warning", count: @unpriced_count) %>
      <%= link_to t(".review_prices"), assets_path %>
    </div>
  <% end %>

  <% if @totals_by_currency.any? %>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-bottom: 16px;">
      <% @totals_by_currency.each do |currency, total| %>
        <div class="card">
          <div class="page-subtitle" style="text-transform: uppercase; letter-spacing: 0.04em; margin-top: 0;">
            <%= @portfolio_names_by_currency.fetch(currency, currency) %> &middot; <%= currency %>
          </div>
          <div style="font-family: var(--font-serif); font-size: 30px; font-weight: 600; margin-top: 6px;"><%= money(total, currency) %></div>
        </div>
      <% end %>
    </div>
  <% end %>

  <% currencies = (@value_over_time_by_currency.keys | @allocation_by_currency.keys) %>
  <% if currencies.any? %>
    <div data-controller="currency-tabs" style="margin-bottom: 16px;">
      <% if currencies.size > 1 %>
        <div style="display: flex; justify-content: flex-end; align-items: center; gap: 8px; margin-bottom: 10px;">
          <span class="page-subtitle" style="margin: 0;"><%= t(".showing_currency") %></span>
          <div class="pill-toggle">
            <% currencies.each_with_index do |currency, index| %>
              <button type="button" class="<%= class_names("pill-toggle__option", active: index.zero?) %>"
                      data-currency-tabs-target="tab" data-currency="<%= currency %>"
                      data-action="currency-tabs#select" data-currency-tabs-currency-param="<%= currency %>">
                <%= currency %>
              </button>
            <% end %>
          </div>
        </div>
      <% end %>

      <div style="display: grid; grid-template-columns: 1.4fr 1fr; gap: 16px;">
        <div class="card">
          <div style="font-weight: 600; margin-bottom: 12px;"><%= t(".value_over_time") %></div>
        <% currencies.each_with_index do |currency, index| %>
          <div data-currency-tabs-target="panel" data-currency="<%= currency %>" <%= "hidden" unless index.zero? %>>
            <% if @value_over_time_by_currency[currency].present? %>
              <%= line_chart @value_over_time_by_currency[currency],
                    prefix: currency == "USD" ? "$" : "#{currency} ",
                    library: { scales: { y: { beginAtZero: false } } } %>
            <% else %>
              <p class="page-subtitle" style="margin-top: 0;"><%= t(".chart_pending") %></p>
            <% end %>
          </div>
        <% end %>
      </div>

      <div class="card">
        <div style="font-weight: 600; margin-bottom: 12px;"><%= t(".allocation_by_type") %></div>
        <% currencies.each_with_index do |currency, index| %>
          <div data-currency-tabs-target="panel" data-currency="<%= currency %>" <%= "hidden" unless index.zero? %>>
            <% allocation = @allocation_by_currency[currency] %>
            <% if allocation.blank? %>
              <p class="page-subtitle" style="margin-top: 0;"><%= t(".no_allocation") %></p>
            <% else %>
              <div style="display: flex; gap: 16px; align-items: center;">
                <div style="width: 120px; flex-shrink: 0;">
                  <%= pie_chart allocation, donut: true,
                        colors: allocation.keys.map { |type| Asset::TYPE_COLORS[type] },
                        library: { plugins: { legend: { display: false }, tooltip: { enabled: false } } } %>
                </div>
                <ul class="legend" style="flex: 1;">
                  <% allocation.each do |type, percent| %>
                    <li>
                      <span class="legend__dot" style="background: <%= Asset::TYPE_COLORS[type] %>;"></span>
                      <span class="legend__label"><%= type.humanize %></span>
                      <strong><%= percent %>%</strong>
                    </li>
                  <% end %>
                </ul>
              </div>
            <% end %>
          </div>
        <% end %>
        </div>
      </div>
    </div>
  <% else %>
    <p class="page-subtitle" style="margin-bottom: 16px;"><%= t(".chart_pending") %></p>
  <% end %>

  <div style="display: grid; grid-template-columns: 1.4fr 1fr; gap: 16px;">
    <div class="card">
      <div style="font-weight: 600; margin-bottom: 12px;"><%= t(".current_holdings") %></div>
      <% if @holdings.empty? %>
        <p class="page-subtitle" style="margin-top: 0;"><%= t(".no_holdings") %></p>
      <% else %>
        <table class="data-table">
          <thead>
            <tr>
              <th><%= t(".asset") %></th>
              <th><%= t(".qty") %></th>
              <th><%= t(".price") %></th>
              <th><%= t(".value") %></th>
            </tr>
          </thead>
          <tbody>
            <% @holdings.each do |holding| %>
              <tr>
                <td><strong><%= holding.asset.symbol %></strong></td>
                <td><%= holding.quantity %></td>
                <td><%= holding.price ? money(holding.price, holding.asset.currency) : t(".no_price") %></td>
                <td><%= holding.value ? money(holding.value, holding.asset.currency) : t(".no_price") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
    </div>

    <div class="card">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
        <span style="font-weight: 600;"><%= t(".recent_entries") %></span>
        <%= link_to t(".view_all"), entries_path %>
      </div>
      <% if @recent_line_items.empty? %>
        <p class="page-subtitle" style="margin-top: 0;"><%= t(".no_entries") %></p>
      <% else %>
        <ul class="record-list">
          <% @recent_line_items.each do |line_item| %>
            <li style="flex-direction: column; align-items: flex-start; gap: 2px;">
              <div style="display: flex; justify-content: space-between; width: 100%;">
                <span class="record-list__label"><%= line_item.display_description %></span>
                <strong><%= money(line_item.amount, line_item.asset.currency) %></strong>
              </div>
              <span class="record-list__meta"><%= l(line_item.occurred_on, format: :long) %> &middot; <%= line_item.action.humanize %></span>
            </li>
          <% end %>
        </ul>
      <% end %>
    </div>
  </div>
<% end %>
